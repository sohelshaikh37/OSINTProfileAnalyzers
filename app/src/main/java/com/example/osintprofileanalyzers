package com.example.osintprofileanalyzer;

import android.os.Bundle;
import android.text.TextUtils;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

import java.io.IOException;
import java.net.HttpURLConnection;
import java.net.URL;

public class MainActivity extends AppCompatActivity {

EditText usernameInput;
TextView resultText;
Button analyzeButton;

@Override
protected void onCreate(Bundle savedInstanceState) {
    super.onCreate(savedInstanceState);

    LinearLayout layout = new LinearLayout(this);
    layout.setOrientation(LinearLayout.VERTICAL);
    layout.setPadding(40, 60, 40, 40);

    TextView title = new TextView(this);
    title.setText("OSINT PROFILE ANALYZER");
    title.setTextSize(26);

    TextView subtitle = new TextView(this);
    subtitle.setText(
            "Public-page verification\n"
                    + "No login • No private access • No bypass"
    );
    subtitle.setTextSize(16);
    subtitle.setPadding(0, 15, 0, 25);

    usernameInput = new EditText(this);
    usernameInput.setHint("Enter username");
    usernameInput.setSingleLine(true);

    analyzeButton = new Button(this);
    analyzeButton.setText("VERIFY PUBLIC PROFILES");

    resultText = new TextView(this);
    resultText.setTextSize(16);
    resultText.setPadding(0, 25, 0, 25);

    ScrollView scrollView = new ScrollView(this);
    scrollView.addView(resultText);

    layout.addView(title);
    layout.addView(subtitle);
    layout.addView(usernameInput);
    layout.addView(analyzeButton);
    layout.addView(scrollView);

    setContentView(layout);

    analyzeButton.setOnClickListener(v -> verifyProfiles());
}

private void verifyProfiles() {

    String username = usernameInput.getText().toString().trim();

    if (TextUtils.isEmpty(username)) {
        resultText.setText("Please enter a username.");
        return;
    }

    String clean = username.replace("@", "");

    analyzeButton.setEnabled(false);
    resultText.setText("Checking public pages...\nPlease wait.");

    new Thread(() -> {

        StringBuilder report = new StringBuilder();

        report.append("PUBLIC PROFILE / OSINT REPORT\n");
        report.append("==============================\n\n");
        report.append("TARGET\n");
        report.append(clean);
        report.append("\n\n");

        checkProfile(
                report,
                "Instagram",
                "https://www.instagram.com/" + clean + "/"
        );

        checkProfile(
                report,
                "X / Twitter",
                "https://x.com/" + clean
        );

        checkProfile(
                report,
                "Reddit",
                "https://www.reddit.com/user/" + clean + "/"
        );

        checkProfile(
                report,
                "GitHub",
                "https://github.com/" + clean
        );

        checkProfile(
                report,
                "TikTok",
                "https://www.tiktok.com/@" + clean
        );

        report.append("\nASSESSMENT\n");
        report.append("Public-page availability check completed.\n\n");

        report.append("NOTE\n");
        report.append(
                "HTTP accessibility does not by itself prove that "
                        + "the exact profile exists.\n"
        );
        report.append(
                "Some platforms may use redirects, login pages, "
                        + "anti-bot systems, or generic responses.\n"
        );
        report.append(
                "No login, private-account access, credential collection, "
                        + "or bypass is performed."
        );

        runOnUiThread(() -> {
            resultText.setText(report.toString());
            analyzeButton.setEnabled(true);
        });

    }).start();
}

private void checkProfile(
        StringBuilder report,
        String platform,
        String profileUrl
) {

    int statusCode = -1;

    try {

        URL url = new URL(profileUrl);

        HttpURLConnection connection =
                (HttpURLConnection) url.openConnection();

        connection.setRequestMethod("HEAD");
        connection.setConnectTimeout(8000);
        connection.setReadTimeout(8000);
        connection.setInstanceFollowRedirects(true);

        connection.setRequestProperty(
                "User-Agent",
                "Mozilla/5.0"
        );

        statusCode = connection.getResponseCode();

        connection.disconnect();

    } catch (IOException e) {

        try {

            URL url = new URL(profileUrl);

            HttpURLConnection connection =
                    (HttpURLConnection) url.openConnection();

            connection.setRequestMethod("GET");
            connection.setConnectTimeout(8000);
            connection.setReadTimeout(8000);
            connection.setInstanceFollowRedirects(true);

            connection.setRequestProperty(
                    "User-Agent",
                    "Mozilla/5.0"
            );

            statusCode = connection.getResponseCode();

            connection.disconnect();

        } catch (IOException ignored) {
            statusCode = -1;
        }
    }

    report.append(platform);
    report.append("\n");

    report.append(" • ");
    report.append(profileUrl);
    report.append("\n");

    if (statusCode >= 200 && statusCode < 300) {

        report.append(" • Status: ACCESSIBLE (HTTP ");
        report.append(statusCode);
        report.append(")\n\n");

    } else if (statusCode == 404) {

        report.append(" • Status: NOT FOUND (HTTP 404)\n\n");

    } else if (statusCode == 401 || statusCode == 403) {

        report.append(" • Status: BLOCKED / RESTRICTED (HTTP ");
        report.append(statusCode);
        report.append(")\n\n");

    } else if (statusCode == 429) {

        report.append(" • Status: RATE LIMITED (HTTP 429)\n\n");

    } else if (statusCode > 0) {

        report.append(" • Status: UNKNOWN (HTTP ");
        report.append(statusCode);
        report.append(")\n\n");

    } else {

        report.append(" • Status: UNKNOWN / NETWORK ERROR\n\n");
    }
}

}
